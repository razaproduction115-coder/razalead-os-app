{
  "version": 2,
  "crons": [
    { "path": "/api/cron/automations", "schedule": "0 4 * * *" }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index"
    },
    {
      "source": "/dashboard",
      "destination": "/api/index"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/webhooks/(.*)",
      "destination": "/api/index"
    }
  ]
}
